<Window x:Class="BaiTap2_RSA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AES &amp; RSA Cryptographic Suite - Bài 2" Height="820" Width="1050"
        WindowStartupLocation="CenterScreen" Background="#0F172A">
    <Window.Resources>
        <!-- Style Button Chung -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style TabItem Đẹp Sắc Nét -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="#0F172A" BorderBrush="#334155" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Margin="2,0">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- HEADER BANNER -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="10" Padding="15" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔑 BÀI 2: MÃ HÓA BẤT ĐỐI XỨNG RSA &amp; CHỮ KÝ SỐ (.NET C#)" FontSize="17" FontWeight="Bold" Foreground="#38BDF8"/>
                        <Border Background="#0284C7" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                            <TextBlock Text="RSA-2048 / RSASSA-PSS" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Học phần: An toàn và bảo mật thông tin | Đồ án mã hóa bất đối xứng" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#0F172A" CornerRadius="8" Padding="12,8" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel TextElement.Foreground="#F1F5F9" TextElement.FontSize="12">
                        <TextBlock Text="👤 SV: Trần Hoàng Xuân Vũ" FontWeight="Bold" Foreground="#10B981"/>
                        <TextBlock Text="🆔 MSSV: K235480106080" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- TAB CONTROL -->
        <TabControl Grid.Row="1" Background="#1E293B" BorderBrush="#334155" Margin="0,0,0,12">
            <!-- TAB 1: SINH & XUẤT KHÓA -->
            <TabItem Header="🔑 1. Sinh &amp; Xuất Khóa">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Name="btnGenRSA" Content="⚡ Sinh Cặp Khóa RSA (2048-bit)" Background="#2563EB" Width="220" Height="36" Click="BtnGenRSA_Click"/>
                        <Button Name="btnExportPub" Content="💾 Xuất Public Key (.pem)" Background="#059669" Width="180" Height="36" Margin="10,0,0,0" Click="BtnExportPub_Click"/>
                        <Button Name="btnExportPriv" Content="💾 Xuất Private Key (.pem)" Background="#DC2626" Width="180" Height="36" Margin="10,0,0,0" Click="BtnExportPriv_Click"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Public Key (PKCS#1 / PEM)" Grid.Column="0" Foreground="#38BDF8" BorderBrush="#334155">
                            <TextBox Name="txtPublicKeyPEM" Background="#0F172A" Foreground="#F1F5F9" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
                        </GroupBox>
                        <GroupBox Header="Private Key (PKCS#1 / PEM)" Grid.Column="2" Foreground="#EF4444" BorderBrush="#334155">
                            <TextBox Name="txtPrivateKeyPEM" Background="#0F172A" Foreground="#F1F5F9" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: PHÂN TÍCH PEM & ASN.1 -->
            <TabItem Header="🔍 2 &amp; 3 &amp; 4. Phân Tích PEM &amp; Import Key">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Name="btnImportPubPEM" Content="📂 Import Public Key (.pem)" Background="#0D9488" Width="200" Height="36" Click="BtnImportPubPEM_Click"/>
                        <Button Name="btnImportPrivPEM" Content="📂 Import Private Key (.pem)" Background="#7C3AED" Width="200" Height="36" Margin="10,0,0,0" Click="BtnImportPrivPEM_Click"/>
                    </StackPanel>
                    <GroupBox Header="Chi tiết các tham số toán học bóc tách từ PEM / ASN.1 DER" Grid.Row="1" Foreground="#38BDF8" BorderBrush="#334155">
                        <TextBox Name="txtKeyDetails" Background="#0F172A" Foreground="#F1F5F9" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- TAB 3: MÃ HÓA & GIẢI MÃ -->
            <TabItem Header="🔒 5 &amp; 6. Mã Hóa &amp; Giải Mã Dữ Liệu">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Mảng byte đầu vào (Tối đa 190 bytes - ví dụ: Khóa AES-256 32 bytes dưới dạng Base64):" Foreground="#94A3B8" Margin="0,0,0,5"/>
                        <TextBox Name="txtDataToEncrypt" Height="35" Background="#0F172A" Foreground="#F1F5F9" Padding="8" VerticalContentAlignment="Center" Text="1OKmo85Yh6p6YtYxbXqS+3FIqa450xu81Ewl1j2Xfzbw="/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Bản Mã Ciphertext (Base64)" Grid.Column="0" Foreground="#F59E0B" BorderBrush="#334155">
                            <TextBox Name="txtCiphertextBase64" Background="#0F172A" Foreground="#F1F5F9" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </GroupBox>
                        <GroupBox Header="Kết Quả Sau Khi Giải Mã bằng Private Key" Grid.Column="2" Foreground="#10B981" BorderBrush="#334155">
                            <TextBox Name="txtDecryptedResult" Background="#0F172A" Foreground="#F1F5F9" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
                        </GroupBox>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Name="btnEncryptRSA" Content="🔒 Mã Hóa Bằng Public Key (Save File)" Background="#E11D48" Width="250" Height="36" Click="BtnEncryptRSA_Click"/>
                        <Button Name="btnDecryptRSA" Content="🔓 Giải Mã Bằng Private Key (So Sánh)" Background="#059669" Width="250" Height="36" Margin="15,0,0,0" Click="BtnDecryptRSA_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 4: BENCHMARK TỐC ĐỘ -->
            <TabItem Header="🚀 7. Đánh Giá Tốc Độ (Benchmark)">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Name="btnBenchmarkRSA" Content="⚡ Chạy Benchmark 500 Phép Tính (Public vs Private)" Background="#2563EB" Width="350" Height="36" Click="BtnBenchmarkRSA_Click"/>
                    </StackPanel>
                    <GroupBox Header="Báo cáo phân tích cơ chế toán học (Modulus Exponentiation &amp; CRT)" Grid.Row="1" Foreground="#38BDF8" BorderBrush="#334155">
                        <TextBox Name="txtBenchmarkReport" Background="#0F172A" Foreground="#F1F5F9" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- TAB 5: SHA-256 AVALANCHE EFFECT -->
            <TabItem Header="❄️ 8. SHA-256 &amp; Hiệu Ứng Tuyết Rơi">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Nhập dữ liệu văn bản để băm SHA-256 realtime:" Foreground="#94A3B8" Margin="0,0,0,5"/>
                        <TextBox Name="txtSHAInput" Height="35" Background="#0F172A" Foreground="#F1F5F9" Padding="8" VerticalContentAlignment="Center" Text="Trần Hoàng Xuân Vũ - K235480106080" TextChanged="TxtSHAInput_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Name="btnSetSHAAnchor" Content="📌 Đặt Mốc So Sánh Ban Đầu" Background="#7C3AED" Width="220" Height="34" Click="BtnSetSHAAnchor_Click"/>
                        <Button Name="btnFlipBit" Content="🔀 Tự Động Thay Đổi 1 Bit Cuối" Background="#D97706" Width="220" Height="34" Margin="10,0,0,0" Click="BtnFlipBit_Click"/>
                    </StackPanel>
                    <GroupBox Header="Phân tích mức độ biến đổi Bit (Avalanche Effect Analysis)" Grid.Row="2" Foreground="#10B981" BorderBrush="#334155">
                        <TextBox Name="txtSHAReport" Background="#0F172A" Foreground="#F1F5F9" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- TAB 6: CHỮ KÝ SỐ & RSASSA-PSS -->
            <TabItem Header="✍️ 9. Chữ Ký Số &amp; Giải Pháp PSS">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Name="btnSignPSS" Content="✍️ Ký 3 Lần Bằng Chuẩn RSASSA-PSS (Mỗi lần 1 Chữ Ký Khác Nhau)" Background="#E11D48" Width="430" Height="36" Click="BtnSignPSS_Click"/>
                        <Button Name="btnVerifyPSS" Content="✅ Xác Thực Cả 3 Chữ Ký Bằng Public Key" Background="#059669" Width="280" Height="36" Margin="10,0,0,0" Click="BtnVerifyPSS_Click"/>
                    </StackPanel>
                    <GroupBox Header="Đề xuất giải pháp &amp; Trải nghiệm chữ ký số ngẫu nhiên RSASSA-PSS (RFC 8017)" Grid.Row="1" Foreground="#F59E0B" BorderBrush="#334155">
                        <TextBox Name="txtPSSReport" Background="#0F172A" Foreground="#F1F5F9" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- TERMINAL LOG CONSOLE -->
        <Border Grid.Row="2" Background="#090D16" CornerRadius="10" Padding="12" BorderBrush="#1E293B" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button Name="btnClearLog" Content="🧹 Xóa Log" DockPanel.Dock="Right" Width="80" Height="24" FontSize="11" Background="#334155" Click="BtnClearLog_Click"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0"/>
                        <TextBlock Text="SYSTEM LOG CONSOLE" Foreground="#64748B" FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </DockPanel>
                <RichTextBox Name="rtbLog" Grid.Row="1" Background="Transparent" Foreground="#E2E8F0" BorderThickness="0" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>